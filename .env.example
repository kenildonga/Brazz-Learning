# Server Configuration
PORT=5000

# Database Configuration
MONGO_URI=mongodb://localhost:27017/vibetint

# Authentication
JWT_SECRET=your_jwt_secret_key_here
API_KEY=your_api_key_here

# Admin panel bootstrap (bun run seed:admin). Existing admins are left unchanged.
# Reset an existing admin password with: bun run seed:admin:reset
ADMIN_EMAIL=admin@brazz.com
ADMIN_PASSWORD=
ADMIN_NAME=Admin User

# Mobile adsConfig. Show counts and placement ids are read from these variables.
# ADS_BANNER_SHOW=2
# ADS_NATIVE_SHOW=2
# ADS_INTERSTITIAL_SHOW=2
# ADS_REWARDS_SHOW=2
# ADS_NATIVE_PLACE=4
# ADS_BLOCKER_POPUP=1
# ADS_UNITY_GAME_ID=800385033
# ADS_GOOGLE_BANNER=
# ADS_GOOGLE_NATIVE=
# ADS_GOOGLE_INTERSTITIAL=
# ADS_META_BANNER=
# ADS_META_NATIVE=
# ADS_META_INTERSTITIAL=
# ADS_UNITY_BANNER=
# ADS_UNITY_NATIVE=
# ADS_UNITY_INTERSTITIAL=

# Join links returned by POST /device/deep-link
DEEP_LINK_ORIGIN=https://brazz-learning.online

# External APIs
PORNREELS_BASE_URL=https://pornreels.tv

# Adult video playback via embed-players. Video detail returns
# <PLAYER_BASE_URL>/hls/<signed token>/index.m3u8 in data.video.m3u8.
# PLAYBACK_JWT_SECRET must be identical in embed-players, at least 32 characters,
# and different from JWT_SECRET. Generate one with: openssl rand -base64 48
PLAYER_BASE_URL=https://player.example.com
PLAYBACK_JWT_SECRET=
# Playlist URL lifetime in seconds (60-43200, default 14400).
# PLAYBACK_TOKEN_TTL_SECONDS=14400

# Prefix for relative video thumbnails (thumbnails/...). Absolute URLs are left unchanged.
THUMBNAIL_BASE_URL=https://pub-ad93fab2bd244c4397c55ab05d543fd0.r2.dev
