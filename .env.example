# Server Configuration
PORT=5000

# Database Configuration
MONGO_URI=mongodb://localhost:27017/vibetint

# Authentication
JWT_SECRET=your_jwt_secret_key_here
API_KEY=your_api_key_here

# Admin panel bootstrap (bun run seed:admin). Existing admins are left unchanged.
# Reset an existing admin password with: bun run seed:admin:reset
